{application, ollama_filter, [
    {description, "em_filter example for Ollama"},
    {vsn, "0.2.0"},
    {registered, [ollama_filter_sup, ollama_filter_server]},
    {mod, {ollama_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        cowboy,
        em_filter
    ]},
    {env, [
        {pop_port,   0},
        {query_port, 0},
        {pop_seeds,  []}
    ]},
    {modules, [
        ollama_filter_sup,
        ollama_filter_server
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/ollama_filter"}]}
]}.
